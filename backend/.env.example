# Production Database URI (MongoDB Atlas)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/satellite-mission-control?retryWrites=true&w=majority

# JWT Secret for Auth
JWT_SECRET=your_super_secret_key_here

# Port (Render will automatically assign a PORT in production, but 5000 is default locally)
PORT=5000

# Optional: Restrict CORS to your Vercel frontend domain in production
# FRONTEND_URL=https://your-frontend-project.vercel.app
